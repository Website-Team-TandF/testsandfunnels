---
/**
 * Home page (placeholder).
 *
 * Why it exists right now: confirms the Astro + Tailwind v4 + React scaffold
 *   renders and that Tailwind utility classes are active.
 * Where it's going: this gets replaced by the real home page, assembled from
 *   reusable section components (Hero, CardGrid, ProofMetrics, CtaBand, ...).
 */
import Layout from '../layouts/Layout.astro';
---

<Layout title="tests&funnels" description="Scaffold running.">
