# Copy to backend/.env and adjust. backend/.env is gitignored.
PORT=5000

# Local MongoDB (start it with: mongod). Or paste an Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/testsandfunnels

# Auth: change these before any real use.
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# CORS: the dashboard/website origin allowed to call the API (* = any, dev only).
CLIENT_ORIGIN=*
